settings = {
    excludeFiles = {
        all = {
            "Decompiled/*",
            "FR2-ORIGINAL/*",
            ".git/*",
            "frontend/*",
            "backend/*",
            "tests/*",
            "scripts/*",
            ".github/*",
            ".github/ISSUE_TEMPLATE/*",
            ".editor/*",
            "*.md",
            "*.bat",
            ".luarc.json",
            ".gitignore"
        },
        osx = {
            "*"
        },
        android = {
            "Icon-win32.ico"
        },
        iphone = {
            "Icon-win32.ico"
        },
        win32 = {
            "AndroidResources/*",
            "iOSResources/*",
            "LaunchScreen.storyboardc/*"
        }
    },

    win32 = {
        singleInstance = true
    },
    window = {
        titleText = {
            default = "FR2: Reborn"
        },
        defaultMode = "fullscreen",
        defaultViewWidth = 1080,
        defaultViewHeight = 1920,
        minViewWidth = 480,
        minViewHeight = 854,
        resizable = true,
        enableMaximizeButton = true,
        enableMinimizeButton = true,
        enableCloseButton = true,
        suspendWhenMinimized = true
    },

    orientation = {
        default = "landscapeRight",
        supported = { "landscapeRight", "landscapeLeft" }
    },

    splashScreen = {
        ios = {
            enable = false
        }
    },

    plugins = {},

    iphone = {
        xcassets = "iOSResources/Images.xcassets",
        plist = {
            UIStatusBarHidden = true,
            UIViewControllerBasedStatusBarAppearance = false,
            UILaunchStoryboardName = "LaunchScreen",
            UIRequiresFullScreen = true,
            NSLocalNetworkUsageDescription = "Find nearby players and race them on your local network.",
            CFBundleDisplayName = "FR2: Reborn",
            CFBundleShortVersionString = "1.1.0",
            CFBundleVersion = "1.1.0"
        }
    },

    android = {
        versionCode = "2",
        versionName = "1.1.0",
        strings = {
            app_name = "FR2: Reborn"
        },
        usesPermissions = { "android.permission.INTERNET" }
    }
}
