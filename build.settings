settings = {
    orientation = {
        default = "landscapeRight",
        supported = { "landscapeRight", "landscapeLeft" }
    },

    window = {
        defaultMode = "fullscreen",
        defaultViewWidth = 1920,
        defaultViewHeight = 1080,
        resizable = true,
        titleText = {
            default = "Fun Run 2 - Offline"
        }
    },

    -- Offline-only project: no monetization, no ads, no IAP, no analytics
    plugins = {},

    iphone = {
        plist = {
            UIStatusBarHidden = true,
            CFBundleDisplayName = "FR2 Offline"
        }
    },

    android = {
        usesPermissions = {
            "android.permission.INTERNET"
        }
    }
}
