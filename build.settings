settings = {
    excludeFiles = {
        all = {
            "Decompiled/*",
            "FR2-ORIGINAL/*",
            ".git/*",
            -- Development files that are not part of the game.
            "frontend/*",
            "backend/*",
            "tests/*",
            "scripts/*",
            ".editor/*",
            "*.md",
            ".luarc.json",
            ".gitignore"
        },
        osx = {
            "*"
        },
        win32 = {
            "*"
        }
    },

    orientation = {
        default = "landscapeRight",
        supported = { "landscapeRight", "landscapeLeft" }
    },

    splashScreen = {
        ios = {
            enable = false
        }
    },

    -- Offline-only project: no monetization, no ads, no IAP, no analytics
    plugins = {},

    iphone = {
        xcassets = "iOSResources/Images.xcassets",
        plist = {
            UIStatusBarHidden = true,
            UIViewControllerBasedStatusBarAppearance = false,
            UILaunchStoryboardName = "LaunchScreen",
            UIRequiresFullScreen = true,
            CFBundleDisplayName = "FR2: Reborn",
            CFBundleShortVersionString = "1.0.0",
            CFBundleVersion = "1.0.0"
        }
    },

    android = {
        versionName = "1.0.0",
        -- Name under the icon on Android (overrides the build dialog's Application Name).
        strings = {
            app_name = "FR2: Reborn"
        },
        usesPermissions = {
            "android.permission.INTERNET",
            "android.permission.ACCESS_NETWORK_STATE"
        }
    }
}
