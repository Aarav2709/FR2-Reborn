settings = {
    excludeFiles = {
        all = {
            "Decompiled/*",
            "FR2-ORIGINAL/*",
            ".git/*",
            -- Development files that are not part of the game.
            "frontend/*",
            "backend/*",
            "tests/*",
            "scripts/*",
            ".editor/*",
            "*.md",
            "*.bat",
            ".luarc.json",
            ".gitignore"
        },
        osx = {
            "*"
        },
        -- Mobile builds leave out the Windows icon.
        android = {
            "Icon-win32.ico"
        },
        iphone = {
            "Icon-win32.ico"
        },
        -- Windows builds leave out the mobile only resources.
        win32 = {
            "AndroidResources/*",
            "iOSResources/*",
            "LaunchScreen.storyboardc/*"
        }
    },

    -- Windows desktop build (Solar2D: Build, Windows); Android and iOS builds ignore
    -- these. It opens fullscreen; F11 switches to a 1920 by 1080 window (sizes are given
    -- relative to the portrait orientation, so they read swapped).
    win32 = {
        singleInstance = true
    },
    window = {
        titleText = {
            default = "FR2: Reborn"
        },
        defaultMode = "fullscreen",
        defaultViewWidth = 1080,
        defaultViewHeight = 1920,
        minViewWidth = 480,
        minViewHeight = 854,
        resizable = true,
        enableMaximizeButton = true,
        enableMinimizeButton = true,
        enableCloseButton = true,
        suspendWhenMinimized = true
    },

    orientation = {
        default = "landscapeRight",
        supported = { "landscapeRight", "landscapeLeft" }
    },

    splashScreen = {
        ios = {
            enable = false
        }
    },

    -- Offline-only project: no monetization, no ads, no IAP, no analytics
    plugins = {},

    iphone = {
        xcassets = "iOSResources/Images.xcassets",
        plist = {
            UIStatusBarHidden = true,
            UIViewControllerBasedStatusBarAppearance = false,
            UILaunchStoryboardName = "LaunchScreen",
            UIRequiresFullScreen = true,
            CFBundleDisplayName = "FR2: Reborn",
            CFBundleShortVersionString = "1.0.0",
            CFBundleVersion = "1.0.0"
        }
    },

    android = {
        -- Raise versionCode by one for every release (and keep the same package name and
        -- signing key), so updates install over the old version and keep the save.
        versionCode = "1",
        versionName = "1.0.0",
        -- Name under the icon on Android (overrides the build dialog's Application Name).
        strings = {
            app_name = "FR2: Reborn"
        },
        usesPermissions = {
            "android.permission.INTERNET",
            "android.permission.ACCESS_NETWORK_STATE"
        }
    }
}
